{
  "info": {
    "name": "Reservas Viajes360",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Reserva Éxito",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"cliente\":\"Ana Torres\",\"vuelo_destino\":\"Madrid\",\"hotel_nombre\":\"Hotel Central\",\"monto_total\":850.00}"
        },
        "url": {
          "raw": "http://localhost:8080/api/reservar",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["api","reservar"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Respuesta con reservas_confirmadas y detalles correctos\", function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json.status).to.eql(\"reservas_confirmadas\");",
              "    pm.expect(json.vuelo.status).to.eql(\"reserva_vuelo_confirmada\");",
              "    pm.expect(json.hotel.status).to.eql(\"reserva_hotel_confirmada\");",
              "    pm.expect(json.pago.status).to.eql(\"pago_confirmado\");",
              "});"
            ]
          }
        }
      ]
    },
    {
      "name": "Reserva Falla",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"cliente\":\"Ana Torres\",\"vuelo_destino\":\"Madrid\",\"hotel_nombre\":\"Hotel Central\",\"monto_total\":1500.00}"
        },
        "url": {
          "raw": "http://localhost:8080/api/reservar",
          "protocol": "http",
          "host": ["localhost"],
          "port": "8080",
          "path": ["api","reservar"]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code is 500\", function () {",
              "    pm.response.to.have.status(500);",
              "});",
              "",
              "pm.test(\"Mensaje de error de compensación\", function () {",
              "    const json = pm.response.json();",
              "    pm.expect(json.error).to.eql(\"Reserva revertida: falla en el pago\");",
              "});"
            ]
          }
        }
      ]
    }
  ]
}
