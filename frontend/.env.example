# Copia este archivo a .env y configura tus valores

# Configuración del API de MuleSoft
VITE_API_BASE_URL=http://localhost:8081/api
VITE_API_TIMEOUT=10000

# Configuración para diferentes entornos
VITE_ENVIRONMENT=development

# URLs alternativas para otros entornos (opcional)
VITE_API_STAGING_URL=https://staging-mulesoft.com/api
VITE_API_PRODUCTION_URL=https://production-mulesoft.com/api
